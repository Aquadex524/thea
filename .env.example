ANTHROPIC_API_KEY=
# Long random string; the app and the iOS Shortcut send it as a Bearer token
THEA_SHARE_TOKEN=
# Optional: transcripts for TikToks without subtitles, and Instagram
SUPADATA_API_KEY=
# Optional: "Shop on Instacart" button. Key from Instacart's developer dashboard (starts with "keys.")
INSTACART_API_KEY=
# "development" (default, for a development key) or "production"
INSTACART_ENV=development
